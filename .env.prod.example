# Copy to .env.prod and fill in real values before deploying.
# .env.prod is gitignored — never commit it.

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=shisha-tj.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=shisha_tj
POSTGRES_USER=shisha
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters, random, never shared
JWT_SECRET=CHANGE_ME_at_least_32_chars_random_string_here!!

# ── Logging ───────────────────────────────────────────────────────────────────
SEQ_API_KEY=CHANGE_ME_or_leave_empty_if_not_used
